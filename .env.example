# Environment the scripts read (export them; nothing loads .env automatically).
# Never commit a filled-in copy. All optional.

# Read access for private projects in projects.json (build-worlds,
# upstream-changed). Public projects need no token; set one locally only to
# avoid GitHub's anonymous rate limit.
GITHUB_TOKEN=

# Where upstream-changed reads the live deploy's manifest.
DEPLOYED_MANIFEST_URL=https://sebastianfrazier.com/worlds/manifest.json

# A built cabn checkout for `pnpm engine:link` (defaults to ../cabn).
CABN_ENGINE_DIR=../cabn-m9
