# Template for sebastianfrazier.com's static server (Dockerfile).
# scripts/render-caddyfile.ts fills the Content-Security-Policy value from
# csp-policy.ts at image build time, so the policy has one source.
{
	admin off
	auto_https off
	persist_config off
}

# Caddy drops headers the site block set when a handler errors, so the error
# route imports the same set rather than keeping a second copy.
(security_headers) {
	header {
		Content-Security-Policy "__SF_CSP__"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), hid=(), bluetooth=(), midi=()"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	import security_headers

	# Vite's content-hashed chunks sit directly in /assets/; the engine's
	# sprites live in its subdirectories under fixed names and revalidate.
	# worlds/ changes on every rebuild from upstream (every 30 minutes at
	# most), so it gets a short shared cache instead of no-cache: a visitor
	# walking a world fetches dozens of chunks.
	@hashed path_regexp ^/assets/[^/]+-[A-Za-z0-9_-]{8}\.(?:js|mjs|css)$
	@worlds path /worlds/*
	@other {
		not path_regexp ^/assets/[^/]+-[A-Za-z0-9_-]{8}\.(?:js|mjs|css)$
		not path /worlds/*
	}
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	header @worlds Cache-Control "public, max-age=300, must-revalidate"
	header @other Cache-Control "no-cache"

	# /play is a client-side route of the SPA; everything else is a file.
	@spa path /play /play/
	rewrite @spa /index.html

	# The build writes blog/index.html and blog/<slug>/index.html, each with
	# its own title and link-preview tags (scripts/build-blog.ts). feed.xml and
	# sitemap.xml match {path} as plain files. A blog path with no file is left
	# to 404, and handle_errors answers it with the SPA shell, which shows the
	# blog's not-found view. try_files takes no matcher of its own (given one,
	# it reads it as another file to try and applies to every request, which
	# turned real 404s into the shell: caught by scripts/check-caddy.ts,
	# 2026-11-23), hence the handle.
	@blog path /blog /blog/*
	handle @blog {
		try_files {path} {path}/index.html
	}

	file_server

	handle_errors {
		import security_headers
		header Cache-Control "no-cache"

		@blog_missing {
			path /blog /blog/*
			expression {err.status_code} == 404
		}
		handle @blog_missing {
			rewrite * /index.html
			file_server {
				status 404
			}
		}
		handle {
			respond {err.status_code}
		}
	}
}
