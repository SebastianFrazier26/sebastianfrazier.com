{
	"name": "sebastianfrazier.com",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"license": "MIT",
	"engines": {
		"node": ">=22.18"
	},
	"packageManager": "pnpm@12.5.1",
	"scripts": {
		"dev": "vite",
		"build:worlds": "node scripts/build-worlds.ts",
		"build:fixture": "node scripts/build-worlds.ts --fixture",
		"build:resume": "node scripts/build-resume.ts",
		"build:assets": "node scripts/copy-engine-assets.ts",
		"build": "pnpm build:assets && pnpm build:resume && tsc --noEmit -p tsconfig.json && vite build",
		"preview": "vite preview",
		"upstream-changed": "node scripts/upstream-changed.ts",
		"render-caddyfile": "node scripts/render-caddyfile.ts Caddyfile Caddyfile.rendered",
		"engine:link": "node scripts/engine-link.ts link",
		"engine:unlink": "node scripts/engine-link.ts unlink",
		"lint": "biome check .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "vitest run",
		"postbuild": "node scripts/check-dist.ts"
	},
	"dependencies": {
		"@cabn/engine": "0.2.0",
		"pdfjs-dist": "6.3.289",
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@cabn/cli": "0.2.0",
		"@cabn/world-schema": "0.2.0",
		"@types/node": "^22.20.4",
		"@types/picomatch": "^4.0.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"picomatch": "^4.0.3",
		"tar": "^7.5.1",
		"typescript": "^7.0.2",
		"vite": "^8.3.0",
		"vitest": "^5.0.1",
		"zod": "^4.6.5"
	}
}
